{
  "name": "hydra-umc-opcua-server",
  "private": true,
  "version": "0.2.7",
  "type": "module",
  "description": "Full mapping of HydraState objects to a standardized, discoverable OPC-UA address space for factory PLCs and SCADA software.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "nodeset": "tsx scripts/export_nodeset.ts"
  },
  "dependencies": {
    "node-opcua": "^2.178.0",
    "node-opcua-types": "2.177.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
